---
import Layout from "./Layout.astro";
import { resolveDefaultOgImagePath } from "@/utils/resolveDefaultOgImagePath";
import { toJsonLd } from "@/utils/structuredData";
import config from "@/config";

type Props = {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  markdownURL?: string;
  pubDatetime?: Date;
  modDatetime?: Date | null;
};

const { site } = config;

const {
  title,
  description,
  ogImage,
  canonicalURL,
  markdownURL,
  pubDatetime,
  modDatetime,
} = Astro.props;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title ?? site.title,
  ...(description && { description }),
  // Google requires an image for Article rich results. Posts without their own
  // image fall back to the site default, matching <meta property="og:image">.
  image: new URL(
    ogImage ?? resolveDefaultOgImagePath(config),
    Astro.site ?? Astro.url
  ).href,
  ...(pubDatetime && { datePublished: pubDatetime.toISOString() }),
  ...(modDatetime && { dateModified: modDatetime.toISOString() }),
  author: [
    {
      "@type": "Person",
      name: site.author,
      ...(site.profile && { url: site.profile }),
    },
  ],
};

const structuredDataJson = toJsonLd(structuredData);
---

<Layout
  {title}
  {description}
  {ogImage}
  {canonicalURL}
  {markdownURL}
  ogType="article"
>
  <Fragment slot="head">
    {
      pubDatetime && (
        <meta
          property="article:published_time"
          content={pubDatetime.toISOString()}
        />
      )
    }
    {
      modDatetime && (
        <meta
          property="article:modified_time"
          content={modDatetime.toISOString()}
        />
      )
    }

    <script
      type="application/ld+json"
      is:inline
      set:html={structuredDataJson}
    />
  </Fragment>

  <slot />
</Layout>
