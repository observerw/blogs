---
import IconArrowLeft from "@/assets/icons/IconArrowLeft.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { getPostUrl } from "@/utils/getPostPaths";
import { useTranslations } from "@/i18n";
import config from "@/config";

type AdjacentPost = {
  id: string;
  title: string;
  filePath: string | undefined;
} | null;

type Props = {
  prevPost: AdjacentPost;
  nextPost: AdjacentPost;
};

const { prevPost, nextPost } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<div data-pagefind-ignore class="post-adjacent">
  {
    prevPost ? (
      <a
        href={getPostUrl(prevPost.id, prevPost.filePath, locale)}
        class="post-adjacent-link is-prev"
      >
        <span class="post-adjacent-label inline-flex items-center gap-1">
          <IconArrowLeft class="inline-block flex-none rtl:rotate-180" />
          {t.post.previousPost}
        </span>
        <span class="post-adjacent-title">{prevPost.title}</span>
      </a>
    ) : (
      <span />
    )
  }
  {
    nextPost && (
      <a
        href={getPostUrl(nextPost.id, nextPost.filePath, locale)}
        class="post-adjacent-link is-next"
      >
        <span class="post-adjacent-label inline-flex items-center justify-end gap-1">
          {t.post.nextPost}
          <IconArrowRight class="inline-block flex-none rtl:rotate-180" />
        </span>
        <span class="post-adjacent-title">{nextPost.title}</span>
      </a>
    )
  }
</div>
